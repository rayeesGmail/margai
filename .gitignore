# OS / IDE
.DS_Store
.idea/
*.iml
.vscode/

# Secrets and local env (also blocked by scripts/block-paths.sh)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.jks

# Claude Code local-only settings
.claude/settings.local.json

# Eval gate stamp (written by eval/run.sh, read by scripts/precommit-gate.sh)
eval/.last-pass

# Server (Maven)
server/target/
server/.mvn/wrapper/*.jar

# App (Flutter)
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/ios/Pods/

# Pipeline
pipeline/.venv/
pipeline/__pycache__/
pipeline/**/__pycache__/
pipeline/data/

# Founder-placed content inputs (NCERT 2022-ed books, PYQ papers, NEET syllabus PDFs): the manifests
# beside them are tracked, the PDFs stay local until the pipeline's S3 content/ home (TECH_PLAN §6.2;
# D14's `ncert register` decides, DECISIONS 2026-09-10 D13)
ncert/**/*.pdf
pyq/**/*.pdf
syllabus/*.pdf

# Founder-collected public-discourse excerpts for the collective intelligence layer (CS-1 §3, F11):
# third-party text never enters the repo; manifest.md and sources.csv beside them are tracked
# (DECISIONS 2026-09-12 CS-1)
pipeline/inputs/collective/excerpts/
