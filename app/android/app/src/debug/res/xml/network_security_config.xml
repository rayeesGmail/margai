<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this file lives in src/debug): plain HTTP to the developer's server on the
     emulator host alias and on a USB-reversed port (TECH_PLAN §5.4). Release builds keep the
     platform default — HTTPS only (TECH_PLAN §9.1). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
