<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- MARG AI server: Spring Boot modular monolith (docs/DEV_SPEC.md §2, §2.1).
       Stack is fixed by CLAUDE.md: Java latest LTS, Spring Boot 4, Maven, Postgres 18 + pgvector. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.margai</groupId>
  <artifactId>server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>margai-server</name>
  <description>MARG AI — NEET mentor API (single deployable)</description>

  <properties>
    <java.version>25</java.version>
    <!-- Spring Modulith is not managed by the Boot BOM; 2.1.x is the line built for Boot 4.1.
         It verifies the module boundaries of TECH_PLAN §1.3–§1.4 in a test (D4, DECISIONS D3.14). -->
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <awssdk.version>2.54.13</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- AWS SDK v2: only the ai module's bedrock package imports it (TECH_PLAN §1.4, ArchUnit). -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- @ApplicationModule / @NamedInterface annotations only; no runtime behaviour. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <!-- @ConfigurationProperties validation at startup (TECH_PLAN §11.5). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- D7 (TECH_PLAN §3.2, §9.1): stateless security chain; HS256 JWTs encoded and decoded
         with the Nimbus support the resource-server starter brings. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <!-- D7 (TECH_PLAN §3.4, §13.3; DECISIONS D3.8): in-process token buckets, one API task;
         Caffeine evicts idle buckets. The shared-store backend is the second-instance upgrade. -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>8.19.0</version>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Prompt templates: StringTemplate 4 group files under resources/prompts (TECH_PLAN §4.12). -->
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>ST4</artifactId>
      <version>4.3.4</version>
    </dependency>
    <!-- Structured output (TECH_PLAN §4.11, DECISIONS D3.21): the output record's JSON schema is
         generated once (victools, Jackson 3 line) and serves both as the forced Bedrock tool's
         input schema and as the validator's schema (networknt, Jackson 3 line). -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
      <version>5.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
      <version>5.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.7</version>
    </dependency>
    <!-- Bedrock Converse + InvokeModel behind BedrockAiClient, active only in the bedrock profile
         (TECH_PLAN §1.2, §4.11). Credentials come from the default chain (an aws login session or
         a named profile locally — TECH_PLAN §7.4 intends an Identity Center profile — and the task
         role in AWS), never from configuration. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>bedrockruntime</artifactId>
    </dependency>
    <!-- Lets the default credential chain use an `aws login` session (a login_session in the
         profile), which is how the founder authenticates locally; loaded reflectively by the
         profile credentials provider, hence runtime scope. In AWS the task role needs nothing. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>signin</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- D7 (founder ruling 2026-09-08): the OTP email channel over SES v2 while the DLT SMS
         template (F1) is blocked. Only auth.internal.email imports it (ArchitectureTest). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sesv2</artifactId>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ArchUnit core for the §1.4 import rules (ArchitectureTest); the same version Modulith
         already brings, declared so the direct use is explicit. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.4.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @DataJpaTest repository slices run Flyway against Testcontainers (TECH_PLAN §8.1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- `./mvnw spring-boot:run` is the developer default (TECH_PLAN §1.2): the local
               profile adds the db/seed test taxonomy. The packaged jar gets no profile here. -->
          <profiles>
            <profile>local</profile>
          </profiles>
        </configuration>
      </plugin>
      <!-- Mockito's inline mock maker must be attached as a -javaagent on JDK 21+; dynamic
           attach prints a warning today and is disallowed by default in a future JDK. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
